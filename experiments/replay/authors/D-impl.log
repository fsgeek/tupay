 \"sort\"
)

// derives: J1.1, J1.3, J1.5, G1.1, G1.2 -- wire and durable values are copied at actor boundaries.
type Ref struct { Proc string "'`json:"proc"`; Seq int `json:"seq"` }
type Entry struct {
 Term int `json:"epoch"`
 Kind string `json:"kind"`
 Payload any `json:"payload"`
 Config []string `json:"config,omitempty"`
 Ref Ref `json:"-"`
}
type Durable struct { Term int; VotedFor string; Log []Entry }
type Record map[string]any

// derives: J1.1, J1.5, G1.2 -- request-specific proof indexes prevent delayed replies from inventing replication.
type Message struct {
 Type, From, To string
 Term int
 Prev, PrevTerm, Last, LastTerm, Commit int
 Entries []Entry
 OK bool
 Matched int
 Proof Ref
 Cause Ref
}
type Input struct { Kind string; Msg Message; Op, Target string; Payload any; Token int }
type Delivery struct { After int; Input Input }
type Output struct { Records []Record; Messages []Message; Timers []Delivery }

// derives: J1.1, J1.3, J1.5, G1.4 -- a request waits for catch-up, prior configuration, then its own commit.
type Request struct {
 Op, Target, Stage string
 Index, Rounds, Goal, Progress, TimeoutToken int
 Ref Ref
}

// derives: J1.1, J1.3, J1.5, G1.1 -- each member has one owner goroutine and isolated durable/volatile state.
type Member struct {
 ID string
 Initial []string
 Store Durable
 Up bool
 Role string
 Commit, Applied int
 Config []string
 ConfigIndex int
 Seq int
 Leader string
 Votes map[string]Ref
 Next, Match map[string]int
 Acks map[string]Ref
 Pending []*Request
 ElectionToken, HeartbeatToken, RequestToken int
 Timeout int
 RNG *rand.Rand
 Mutation string
 Inbox chan Input
 Reply chan Output
 out Output
}

// derives: J1.3, G1.4 -- canonical configurations make identity and quorum membership unambiguous.
func contains(xs []string, x string) bool { for _, v := range xs { if v == x { return true } }; return false }
func canonical(xs []string) []string { out := append([]string(nil), xs...); sort.Strings(out); return out }
func copyEntries(xs []Entry) []Entry {
 out := append([]Entry(nil), xs...)
 for i := range out { out[i].Config = append([]string(nil), out[i].Config...) }
 return out
}
func configPayload(xs []string) any { return canonical(xs) }
func entryKey(e Entry) string { b, _ := json.Marshal(struct{ Term int; Kind string; Payload any }{e.Term,e.Kind,e.Payload}); return string(b) }
func refList(xs map[string]Ref, config []string) []Ref { out:=[]Ref{}; for _, id:= range config { if r,ok:=xs[id]; ok {out=append(out,r)} }; return out }
func majority(config []string) int { return len(config)/2+1 }
func validID(s string) bool { return len(s)==2 && s[0]=='"'m' && s[1]>='1' && s[1]<='5' }
func asInt(v any) int { switch x:=v.(type) {case int: return x; case int64: return int(x); case float64:return int(x); case json.Number: i,_:=x.Int64();return int(i)}; return 0 }
func asString(v any) string { if s,ok:=v.(string);ok{return s}; return fmt.Sprint(v) }
func stringSlice(v any) []string { switch x:=v.(type) {case []string:return append([]string(nil),x...);case []any:out:=[]string{};for _,s:=range x{out=append(out,asString(s))};return out};return nil }
