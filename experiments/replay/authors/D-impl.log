func newEngine(s Scenario, seed int, mutation, run string) *Engine {
	e := &Engine{scenario: s, rng: rand.New(rand.NewSource(int64(seed))), members: map[string]*Member{}, up: map[string]bool{}, links: map[[2]string]bool{}, run: run, lastAction: -1}
	for i, id := range memberIDs {
		e.members[id] = newMember(id, s.Initial, int64(seed)*7919+int64(i+1)*104729, mutation)
		e.up[id] = true
	}
	for _, id := range memberIDs {
		e.deliver(id, Input{Kind: "boot"})
	}
	if len(s.Steps) == 0 {
		e.lastAction = 0
	} else if at, ok := s.Steps[0].At.(string); ok && at == "start" {
		e.armAction(s.Steps[0].Do)
	}
	return e
}
