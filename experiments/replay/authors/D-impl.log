package main

import (
	"encoding/json"
	"fmt"
)

// derives: J1.1, J1.3, J1.5, G1.1, G1.2, G1.3, G1.4 -- the oracle sees records only, never member state or mutation selection.
type observedMember struct {
	log    []Entry
	commit int
}
type electionObservation struct {
	epoch   int
	journal []Entry
	member  string
}
type commitmentObservation struct {
	epoch, index int
	key          string
}

func decodeEntry(r Record) Entry {
	e := Entry{Term: asInt(r["epoch"]), Kind: asString(r["kind"]), Payload: r["payload"]}
	if e.Kind == "config" {
		e.Config = canonical(stringSlice(e.Payload))
	}
	return e
}
func journalFrom(v any) []Entry {
	b, _ := json.Marshal(v)
	var xs []Entry
	_ = json.Unmarshal(b, &xs)
	return xs
}

// derives: J1.1, J1.3, J1.5, G1.1 -- replay truncations and restart commit resets; enforce every historical election/commit obligation.
func checkRecords(initial []string, records []Record) string {
	states := map[string]*observedMember{}
	leaders := map[int]string{}
	elections := []electionObservation{}
	commits := []commitmentObservation{}
	get := func(id string) *observedMember {
		if states[id] == nil {
			states[id] = &observedMember{}
		}
		return states[id]
	}
	for _, r := range records {
		id := asString(r["proc"])
		if id == "env" {
			continue
		}
		st := get(id)
		switch asString(r["event"]) {
		case "Restarted":
			st.commit = 0
		case "Appended":
			index := asInt(r["index"])
			if index != len(st.log)+1 {
				return "UNEXPLAINED observe append index"
			}
			entry := decodeEntry(r)
			if entry.Kind == "config" {
				prev := initial
				for i := len(st.log) - 1; i >= 0; i-- {
					if st.log[i].Kind == "config" {
						prev = st.log[i].Config
						break
					}
				}
				delta := 0
				for _, m := range prev {
					if !contains(entry.Config, m) {
						delta++
					}
				}
				for _, m := range entry.Config {
					if !contains(prev, m) {
						delta++
					}
				}
				if delta != 1 {
					return "FAIL J1.3"
				}
			}
			st.log = append(st.log, entry)
		case "Truncated":
			from := asInt(r["from_index"])
			if from <= st.commit {
				return "FAIL J1.5"
			}
			if from < 1 || from > len(st.log) {
				return "UNEXPLAINED observe truncation index"
			}
			st.log = st.log[:from-1]
		case "Committed":
			index := asInt(r["index"])
			if index < 1 || index > len(st.log) || index < st.commit {
				return "UNEXPLAINED observe commitment index"
			}
			st.commit = index
			leader, _ := r["coordinator"].(bool)
			if leader {
				commits = append(commits, commitmentObservation{asInt(r["epoch"]), index, entryKey(st.log[index-1])})
			}
		case "Elected":
			epoch := asInt(r["epoch"])
			if old, ok := leaders[epoch]; ok && old != id {
				return "FAIL J1.1"
			}
			leaders[epoch] = id
			// The journal is reconstructed independently; the snapshot is checked in auditRecords.
			elections = append(elections, electionObservation{epoch, copyEntries(st.log), id})
		}
	}
	// An older-term coordinator may commit after a higher-term election in the trace. Do not miss that case.
	for _, c := range commits {
		for _, e := range elections {
			if e.epoch > c.epoch && (len(e.journal) < c.index || entryKey(e.journal[c.index-1]) != c.key) {
				return "FAIL J1.5"
			}
		}
	}
	return ""
}

// derives: J1.1, J1.5, G1.2 -- trace evidence identifies configuration and exact counted ballots/replication acknowledgements.
func auditRecords(initial []string, records []Record) error {
	seen := map[Ref]Record{}
	seqs := map[string]int{}
	journals := map[string][]Entry{}
	configs := map[string][]string{}
	for _, r := range records {
		id := asString(r["proc"])
		seq := asInt(r["seq"])
		if seq != seqs[id]+1 {
			return fmt.Errorf("nonconsecutive sequence for %s", id)
		}
		seqs[id] = seq
		raw, _ := json.Marshal(r["causes"])
		var refs []Ref
		if err := json.Unmarshal(raw, &refs); err != nil {
			return err
		}
		for _, ref := range refs {
			if _, ok := seen[ref]; !ok {
				return fmt.Errorf("missing causal predecessor %v", ref)
			}
		}
		event := asString(r["event"])
		if id != "env" {
			if configs[id] == nil {
				configs[id] = canonical(initial)
			}
			switch event {
			case "Appended":
				journals[id] = append(journals[id], decodeEntry(r))
				if r["kind"] == "config" {
					configs[id] = canonical(stringSlice(r["payload"]))
				}
			case "Truncated":
				from := asInt(r["from_index"])
				if from >= 1 && from <= len(journals[id]) {
					journals[id] = journals[id][:from-1]
				}
				configs[id] = canonical(initial)
				for _, v := range journals[id] {
					if v.Kind == "config" {
						configs[id] = canonical(v.Config)
					}
				}
			case "Elected", "Committed":
				if fmt.Sprint(canonical(stringSlice(r["config"]))) != fmt.Sprint(configs[id]) {
					return fmt.Errorf("%s configuration mismatch at %s/%d", event, id, seq)
				}
				if event == "Elected" {
					snapshot := journalFrom(r["journal"])
					if len(snapshot) != len(journals[id]) {
						return fmt.Errorf("election journal length mismatch")
					}
					for i := range snapshot {
						if entryKey(snapshot[i]) != entryKey(journals[id][i]) {
							return fmt.Errorf("election journal mismatch")
						}
					}
					b, _ := json.Marshal(r["voters"])
					var ballots []Ref
					_ = json.Unmarshal(b, &ballots)
					for _, ref := range ballots {
						v := seen[ref]
						if v["event"] != "BallotGranted" || v["candidate"] != id || asInt(v["epoch"]) != asInt(r["epoch"]) {
							return fmt.Errorf("invalid election ballot")
						}
					}
				} else if leader, _ := r["coordinator"].(bool); leader {
					b, _ := json.Marshal(r["acknowledgements"])
					var acks []Ref
					_ = json.Unmarshal(b, &acks)
					for _, ref := range acks {
						v := seen[ref]
						if ref.Proc != id && (v["event"] != "AppendAcknowledged" || v["leader"] != id || asInt(v["epoch"]) != asInt(r["epoch"]) || asInt(v["index"]) < asInt(r["index"])) {
							return fmt.Errorf("invalid commitment acknowledgement")
						}
					}
				}
			}
		}
		seen[Ref{id, seq}] = r
	}
	return nil
}
