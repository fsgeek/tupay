}

// derives: G1.1, G1.3, G1.4 -- selectors are frozen at trigger time, including link endpoints.
func (e *Engine) selector(v any) (string,error) {
 id,ok:=v.(string);if !ok{return "",fmt.Errorf("member must be a string")}
 switch id {
 case "coordinator":if e.coordinator==""{return "",fmt.Errorf("coordinator before Elected")};return e.coordinator,nil
