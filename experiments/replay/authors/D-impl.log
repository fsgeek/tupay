package main

import (
 \"bufio\"
 \"encoding/json\"
 \"flag\"
 \"fmt\"
 \"os\"
 \"path/filepath\"
)

// derives: J1.1, J1.3, J1.5, G1.1, G1.2, G1.3, G1.4 -- the same CLI compiles shared and steward-provided scenario files.
func main(){os.Exit(mainCLI(os.Args[1:]))}
func mainCLI(args []string)int{
 fs:=flag.NewFlagSet(\"replay-D\",flag.ContinueOnError)
 seeds:=fs.Int(\"seeds\",3,\"run seeds 1 through N\")
 mutation:=fs.String(\"mutation\",\"\",\"select a preregistered broken implementation S1..S8\")
 mutations:=fs.Bool(\"mutations\",false,\"run all eight scenario/mutation pairs\")
 out:=fs.String(\"out\",\"\",\"observation directory (default impl/observe)\")
 check:=fs.String(\"check\",\"\",\"check an existing observe JSONL (scenario path also required)\")
 // The documented interface puts a path before flags; flag accepts flags first, so normalize it.
 paths:=[]string{};flags:=[]string{}
 for i:=0;i<len(args);i++{a:=args[i];if len(a)>0 && a[0]=='-' {flags=append(flags,a);if a==\"--seeds\"||a==\"-seeds\"||a==\"--mutation\"||a==\"-mutation\"||a==\"--out\"||a==\"-out\"||a==\"--check\"||a==\"-check\"{if i+1>=len(args){fmt.Fprintln(os.Stderr,\"UNEXPLAINED input missing flag value\");return 2};i++;flags=append(flags,args[i])}}else{paths=append(paths,a)}}
 if err:=fs.Parse(flags);err"'!=nil{return 2};if *seeds<1{fmt.Println("UNEXPLAINED input seeds must be positive");return 2}
 if *mutation!="" && !validMutation(*mutation){fmt.Println("UNEXPLAINED input unknown mutation");return 2}
 base:=os.Getenv("REPLAY_IMPL_ROOT");if base==""{base="."}
 if *out==""{*out=filepath.Join(base,"observe")};if err:=os.MkdirAll(*out,0755);err!=nil{fmt.Println("UNEXPLAINED output",err);return 2}
 if *mutations{
  if len(paths)!=0 || *mutation!="" || *check!=""{fmt.Println("UNEXPLAINED input --mutations runs its registered pairs");return 2}
  status:=0;for _,m:=range []string{"S1","S2","S3","S4","S5","S6","S7","S8"}{path:=filepath.Join(base,"..","replay","scenarios",m+".yaml");if runScenario(path,*seeds,m,*out)!=0{status=1}};return status
 }
 if len(paths)!=1{fmt.Println("UNEXPLAINED input supply one scenario path");return 2}
 if *check!=""{
  s,err:=loadScenario(paths[0]);if err!=nil{fmt.Println("UNEXPLAINED input",err);return 2}
  records,err:=readRecords(*check);if err!=nil{fmt.Println("UNEXPLAINED observe",err);return 2}
  result:=checkRecords(s.Initial,records);if result==""{if err=auditRecords(s.Initial,records);err!=nil{result="UNEXPLAINED observe "+err.Error()}else{result="PASS"}}
  fmt.Println(result);if result!="PASS"{return 1};return 0
 }
 return runScenario(paths[0],*seeds,*mutation,*out)
}
func validMutation(m string)bool{return len(m)==2 && m[0]=='"'S' && m[1]>='1'&&m[1]<='8'}
func runScenario(path string,seeds int,mutation,out string)int{
 s,err:=loadScenario(path);if err"'!=nil{fmt.Println("UNEXPLAINED input",err);return 2};status:=0
 for seed:=1;seed<=seeds;seed++{
  id:=runID(s.Name,seed,mutation);engine:=newEngine(s,seed,mutation,id);result,records:=engine.execute()
  if err:=auditRecords(s.Initial,records);err!=nil{fmt.Fprintln(os.Stderr,id,"observe audit:",err);if result=="PASS"{result="UNEXPLAINED observe "+err.Error()}}
  if err:=writeRecords(filepath.Join(out,id+".jsonl"),records);err!=nil{fmt.Println(id,"UNEXPLAINED output",err);status=1;continue}
  fmt.Printf("%s seed=%d mutation=%s %s'"\\n\",s.Name,seed,mutationLabel(mutation),result)
  if result"'!="PASS"{status=1}
 }
 return status
}
func mutationLabel(m string)string{if m==""{return "none"};return m}
func readRecords(path string)([]Record,error){
 f,err:=os.Open(path);if err!=nil{return nil,err};defer f.Close();scanner:=bufio.NewScanner(f);scanner.Buffer(make([]byte,4096),16*1024*1024);out:=[]Record{}
 for scanner.Scan(){var r Record;if err=json.Unmarshal(scanner.Bytes(),&r);err!=nil{return nil,err};out=append(out,r)};return out,scanner.Err()
}
