   filters,ok:=st.At.(map[string]any);if !ok || !events[asString(filters["event"])]{return s,fmt.Errorf("invalid trigger in step %d",i+1)}
  }
  actions:=0
  for _,k:=range []string{"add","remove","crash","restart","cut","drop","heal","command"}{if _,ok:=st.Do[k];ok{actions++}}
  if actions!=1{return s,fmt.Errorf("step %d must contain exactly one action",i+1)}
  if _,ok:=st.Do["add"];ok{if _,ok=st.Do["at"];!ok{return s,fmt.Errorf("add requires at")}}
  if _,ok:=st.Do["remove"];ok{if _,ok=st.Do["at"];!ok{return s,fmt.Errorf("remove requires at")}}
  if _,ok:=st.Do["command"];ok{if _,ok=st.Do["at"];!ok{return s,fmt.Errorf("command requires at")}}
