package main

import \"math/rand\"

// derives: J1.1, J1.5, G1.1, G1.2 -- a goroutine runs protocol transitions only when the scheduler delivers an input.
func newMember(id string, initial []string, seed int64, mutation string) *Member {
 m:=&Member{ID:id,Initial:canonical(initial),RNG:rand.New(rand.NewSource(seed)),Mutation:mutation,Inbox:make(chan Input),Reply:make(chan Output)}
 go func(){ for in:=range m.Inbox { m.out=Output{};m.handle(in); m.Reply<-m.out } }()
 return m
}

// derives: J1.1, J1.3, J1.5, G1.1, G1.2 -- causal counters are observer metadata, not protocol persistence.
func (m *Member) emit(event string, fields Record, causes ...Ref) Ref {
 m.Seq++
 if fields==nil {fields=Record{}}
 fields[\"proc\"]=m.ID; fields[\"seq\"]=m.Seq;fields[\"event\"]=event
 clean:=[]Ref{};for _,r:=range causes{if r.Proc"'!="" && r.Seq>0 {clean=append(clean,r)}}
 fields["causes"]=clean
 m.out.Records=append(m.out.Records,fields)
 return Ref{m.ID,m.Seq}
}
func (m *Member) schedule(after int, in Input) { m.out.Timers=append(m.out.Timers,Delivery{after,in}) }
func (m *Member) send(msg Message) { msg.From=m.ID;msg.Term=m.Store.Term;m.out.Messages=append(m.out.Messages,msg) }

// derives: J1.1, J1.5, G1.1 -- only currentTerm, votedFor and journal survive restart; latest configuration is derived.
func (m *Member) resetVolatile() {
 m.Role="follower";m.Commit=0;m.Applied=0;m.Leader="";m.Votes=nil;m.Next=nil;m.Match=nil;m.Acks=nil;m.Pending=nil
 m.ElectionToken++;m.HeartbeatToken++;m.RequestToken++
 m.Config=append([]string(nil),m.Initial...);m.ConfigIndex=0
 for i,e:=range m.Store.Log { if e.Kind=="config" { m.Config=append([]string(nil),e.Config...);m.ConfigIndex=i+1 } }
}
func (m *Member) resetElection() {
 m.ElectionToken++; m.Timeout=40+m.RNG.Intn(41)
 if m.Up && contains(m.Config,m.ID) && m.Role!="leader" {m.schedule(m.Timeout,Input{Kind:"election",Token:[REDACTED_SECRET]
}
func (m *Member) latestRef() Ref { return Ref{m.ID,m.Seq} }
func (m *Member) lastTerm() int { if len(m.Store.Log)==0{return 0};return m.Store.Log[len(m.Store.Log)-1].Term }

// derives: J1.1, J1.3, J1.5, G1.1, G1.2, G1.4 -- all protocol state transitions are explicit scheduler inputs.
func (m *Member) handle(in Input) {
 if in.Kind=="boot" || in.Kind=="restart" {
  if m.Up{return};m.Up=true;m.resetVolatile();r:=m.emit("Restarted",Record{"epoch":m.Store.Term,"config":canonical(m.Config),"journal":copyEntries(m.Store.Log)})
  m.emit("ConfigInEffect",Record{"config":canonical(m.Config),"index":m.ConfigIndex},r);m.resetElection();return
 }
 if in.Kind=="crash" {if m.Up {m.emit("Stopped",Record{"epoch":m.Store.Term});m.Up=false;m.resetVolatile()};return}
 if !m.Up{return}
 switch in.Kind {
 case "election": if in.Token=[REDACTED_SECRET] && m.Role!="leader" && contains(m.Config,m.ID){m.startElection()}
 case "heartbeat":if m.Role=="leader" && in.Token=[REDACTED_SECRET] {m.broadcast();m.schedule(10,Input{Kind:"heartbeat",Token:[REDACTED_SECRET]
 case "message":m.receive(in.Msg)
 case "command":if m.Role=="leader" {m.appendLocal(Entry{Term:m.Store.Term,Kind:"command",Payload:in.Payload});m.advanceCommit();m.broadcast()}
 case "change":m.change(in.Op,in.Target)
 case "catchup-timeout":
  if m.Role=="leader" && len(m.Pending)>0 {p:=m.Pending[0];if p.Stage=="catchup" && p.TimeoutToken==in.Token {m.reply(p,"timeout");m.Pending=m.Pending[1:];m.processRequests()}}
 }
}

// derives: J1.1, J1.5, G1.1, G1.2 -- persist term/self-vote before sending, use caller'"'s latest configuration.
func (m *Member) startElection() {
 m.Store.Term++;m.Store.VotedFor=m.ID;m.Role=\"candidate\";m.Leader=\"\";m.resetElection()
 grant:=m.emit(\"BallotGranted\",Record{\"epoch\":m.Store.Term,\"candidate\":m.ID,\"config\":canonical(m.Config)})
 m.Votes=map[string]Ref{m.ID:grant}
 for _,id:=range m.Config { if id"'!=m.ID {m.send(Message{Type:"vote",To:id,Last:len(m.Store.Log),LastTerm:m.lastTerm(),Cause:grant})} }
