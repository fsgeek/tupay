// derives: J1.3, J1.5, G1.2, G1.4 -- latest config rolls back on truncation and incoming nonmember RPCs are processed.
func TestConfigRollbackAndNonmemberRPC_J13_J15_G12_G14(t *testing.T){
 p:=newProbe(t)
 out:=p.step(Input{Kind:"message",Msg:Message{Type:"append",From:"m1",Term:1,Entries:[]Entry{{Term:1,Kind:"config",Config:[]string{"m1","m2","m3"},Payload:[]string{"m1","m2","m3"}}}}})
 if !hasEvent(out,"ConfigInEffect"){t.Fatal("configuration did not take effect")}
 out=p.step(Input{Kind:"message",Msg:Message{Type:"append",From:"m5",Term:2,Entries:[]Entry{{Term:2,Kind:"command",Payload:"replacement"}}}})
 if !hasEvent(out,"Truncated"){t.Fatal("conflict not truncated")}
 found:=false;for _,r:=range out.Records{if r["event"]=="ConfigInEffect" && len(stringSlice(r["config"]))==4{found=true}}
 if !found || !hasEvent(out,"Appended"){t.Fatal("did not restore initial configuration and accept nonmember leader")}
}

// derives: J1.5, G1.2 -- replication counts cannot commit old-term entries until a current-term entry is committed.
func TestOldTermCommitGate_J15_G12(t *testing.T){
 p:=newProbe(t)
 out:=p.step(Input{Kind:"message",Msg:Message{Type:"append",From:"m1",Term:1,Entries:[]Entry{{Term:1,Kind:"command",Payload:"old"}}}})
 p.step(latestElection(out))
 for _,id:=range []string{"m1","m3"}{out=p.step(Input{Kind:"message",Msg:Message{Type:"vote-reply",From:id,Term:2,OK:true}})}
 if !hasEvent(out,"Elected"){t.Fatal("probe did not elect")}
 for _,id:=range []string{"m1","m3"}{out=p.step(Input{Kind:"message",Msg:Message{Type:"append-reply",From:id,Term:2,OK:true,Matched:1}});if hasEvent(out,"Committed"){t.Fatal("old-term entry committed by replica counting")}}
 p.step(Input{Kind:"command",Payload:"new"})
 for _,id:=range []string{"m1","m3"}{out=p.step(Input{Kind:"message",Msg:Message{Type:"append-reply",From:id,Term:2,OK:true,Matched:2}})}
 count:=0;for _,r:=range out.Records{if r["event"]=="Committed"{count++}}
 if count!=2{t.Fatalf("wanted indirect plus current-term commitments, got %d",count)}
}
