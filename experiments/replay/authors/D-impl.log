 if err=yaml.Unmarshal(data,&s);err!=nil{return s,err}
 if s.Name=="" || len(s.Initial)==0 || s.Bound.Events<=0 || s.End.Settle<0{return s,fmt.Errorf("missing scenario/initial/bound or negative settle")}
