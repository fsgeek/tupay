type fixture struct{ c *Checker; seq map[string]int; app map[string]map[int]Ref }
func newFixture()*fixture{return &fixture{newChecker([]string{\"m1\",\"m2\",\"m3\",\"m4\"}),map[string]int{},map[string]map[int]Ref{}}}
func(f *fixture)emit(n,event string,r Record)Ref{
 f.seq[n]++;r[\"proc\"]=n;r[\"seq\"]=f.seq[n];r[\"event\"]=event;r[\"causes\"]=[]Ref{}
 b,_:=json.Marshal(r);var wire Record;_ = json.Unmarshal(b,&wire);f.c.feed(wire)
 return Ref{n,f.seq[n]}
}
func(f *fixture)append(n string,epoch int,kind string,payload any){
 index:=len(f.c.Journals[n])+1;ref:=f.emit(n,\"Appended\",Record{\"index\":index,\"epoch\":epoch,\"kind\":kind,\"payload\":payload})
 if f.app[n]==nil{f.app[n]=map[int]Ref{}};f.app[n][index]=ref
}
func(f *fixture)evidence(n string,counted []Counted)Record{
 j:=[]Entry{};for _,v:=range f.c.Journals[n]{ent:=Entry{Epoch:v.Epoch,Kind:v.Kind};if v.Kind==\"config\"{ent.Config=stringsOf(v.Payload)}else{ent.Command=str(v.Payload)};j=append(j,ent)}
 return Record{\"config\":f.c.config(n),\"journal\":j,\"counted\":counted}
}
func(f *fixture)elect(n string,epoch int){
 counted:=[]Counted{}
