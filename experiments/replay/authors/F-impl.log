        if election||"'!exists||str(prior["event"])!="Committed"||integer(prior["index"])<integer(r["index"]){c.bad("invalid learned commitment source")}
    } else if len(counted)<=len(config)/2{c.bad("decision evidence lacks majority")}
    // Safety failures take precedence over evidence diagnostics for mutants.'"''')
open(p,'w').write(s)
