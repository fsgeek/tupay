// derives: J1.1, J1.3, J1.5, G1.1, G1.2, G1.3, G1.4
var names = []string{\"m1\", \"m2\", \"m3\", \"m4\", \"m5\"}

// derives: J1.5, G1.2
// Origin remains the first coordinator's actual Appended event on every replica.
type Ref struct { Proc string "'`json:"proc"`; Seq int `json:"seq"` }
type Entry struct {
 Epoch int `json:"epoch"`
 Kind string `json:"kind"`
 Command string `json:"command,omitempty"`
 Config []string `json:"config,omitempty"`
 Origin Ref `json:"origin"`
}
func (e Entry) payload() any { if e.Kind == "config" { return e.Config }; return e.Command }

// derives: J1.1, J1.5, G1.1
// Only these fields cross a crash; no commit index or coordinator state is stored.
type Durable struct { Epoch int `json:"epoch"`; VotedFor string `json:"votedFor"`; Journal []Entry `json:"journal"` }

// derives: J1.1, J1.5, G1.2, G1.3
// Replies carry request identity and the evidence record created at the receiver.
type Message struct {
 Type, From, To string
 Epoch, Prev, PrevEpoch, Commit, LastIndex, LastEpoch, Match, Request int
 Entries []Entry
 Success bool
 Evidence, Cause Ref
}

// derives: J1.1, J1.3, J1.5, G1.1, G1.2, G1.3, G1.4
// Scenario identity never determines protocol behavior.
type Scenario struct {
 Name string `yaml:"scenario"`
 Derives []string `yaml:"derives"`
 Initial []string `yaml:"initial"`
 Steps []struct { At any `yaml:"at"`; Do map[string]any `yaml:"do"` } `yaml:"steps"`
 End struct { Settle int `yaml:"settle"` } `yaml:"end"`
 Bound struct { Events int `yaml:"events"` } `yaml:"bound"`
}
func loadScenario(path string) (*Scenario,error) {
 b,err:=os.ReadFile(path); if err!=nil{return nil,err}
 var s Scenario
 if err=yaml.Unmarshal(b,&s);err!=nil{return nil,err}
 if s.Name=="" || len(s.Initial)==0 || s.Bound.Events<=0 || s.End.Settle<0{return nil,fmt.Errorf("invalid scenario header/bounds")}
 seen:=map[string]bool{}
 for _,n:=range s.Initial {if !memberName(n)||seen[n]{return nil,fmt.Errorf("invalid/duplicate initial member %q",n)};seen[n]=true}
 sort.Strings(s.Initial)
 for i,st:=range s.Steps {
  if st.At==nil||st.Do==nil{return nil,fmt.Errorf("step %d lacks at/do",i+1)}
  if x,ok:=st.At.(string);ok&&x!="start"{return nil,fmt.Errorf("unknown trigger %q",x)}
  count:=0;for k:=range st.Do {switch k {case "at":case "add","remove","crash","restart","cut","drop","heal","command":count++;default:return nil,fmt.Errorf("unknown action %q",k)}}
  if count!=1{return nil,fmt.Errorf("step %d must contain one action",i+1)}
 }
 return &s,nil
}
func memberName(n string) bool {for _,v:=range names {if n==v{return true}};return false}
func contains(c []string,n string)bool{for _,v:=range c{if v==n{return true}};return false}
func copyConfig(c []string)[]string{return append([]string{},c...)}
func configDelta(a,b []string)int{n:=0;for _,v:=range a{if !contains(b,v){n++}};for _,v:=range b{if !contains(a,v){n++}};return n}
func min(a,b int)int{if a<b{return a};return b}
func max(a,b int)int{if a>b{return a};return b}

// derives: J1.1, J1.5, G1.1, G1.2, G1.3, G1.4
// Queue ordering is logical time, seeded tie choice, then insertion order.
type Scheduled struct {
 At int
 Tie int64
 Order int
 Kind, Node string
 Generation int
 Msg Message
 Action map[string]any
}
type Queue []*Scheduled
func(q Queue)Len()int{return len(q)}
func(q Queue)Less(i,j int)bool{if q[i].At!=q[j].At{return q[i].At<q[j].At};if q[i].Tie!=q[j].Tie{return q[i].Tie<q[j].Tie};return q[i].Order<q[j].Order}
func(q Queue)Swap(i,j int){q[i],q[j]=q[j],q[i]}
func(q *Queue)Push(v any){*q=append(*q,v.(*Scheduled))}
func(q *Queue)Pop()any{old:=*q;n:=len(old);v:=old[n-1];*q=old[:n-1];return v}

// derives: J1.1, J1.3, J1.5, G1.1, G1.2, G1.3, G1.4
// The scheduler has no wall clock and accesses worker-owned state only via tasks.
type Engine struct {
 S *Scenario
 RNG *rand.Rand
 Q Queue
 Now, Order, Count int
 RunID, Mutation, StateDir string
 Nodes map[string]*Member
 Up map[string]bool
 Blocked map[string]bool
 Seq map[string]int
 Last map[string]Ref
 Writer *json.Encoder
 Checker *Checker
 Step int
 Triggered bool
 LastActionCount int
 Coordinator, Crashed string
 Err error
}
func(e *Engine)schedule(s *Scheduled){e.Order++;s.Order=e.Order;s.Tie=e.RNG.Int63();heap.Push(&e.Q,s)}
func(e *Engine)timer(n,k string,g,delay int){e.schedule(&Scheduled{At:e.Now+delay,Node:n,Kind:k,Generation:g})}
func(e *Engine)persist(n string,d Durable)error{
 b,err:=json.Marshal(d);if err!=nil{return err}
 f:=filepath.Join(e.StateDir,n+".json")
 if err=os.WriteFile(f+".new",b,0600);err!=nil{return err}
 return os.Rename(f+".new",f)
}
EOF
