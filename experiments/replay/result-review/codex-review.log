     1	#!/usr/bin/env python3
     2	"""Replay attribution: does a J1.1 or J1.5 violation in a trace arise from configurations?
     3	
     4	derives: J1.1, J1.5, G1.4 (replay/contract.md v3); experiments/replay-prereg.md "Attribution"
     5	
     6	Reads one observe file (replay/observe.md: one JSON record per line, per-member `seq`,
     7	no cross-member clock). Finds violations of J1.1 and J1.5 and labels each one:
     8	  configuration  the decisions involved counted majorities of different configurations
     9	  mechanics      they did not (an error in the artifact's own mechanics)
    10	A violation fires a detection route only if it is configuration-attributed.
    11	
    12	Inference rules, fixed before any author run (the trace does not record a member's
    13	current epoch, so the epoch in which a commit happened has to be inferred):
    14	- A member's configuration at one of its records is the `config` of its latest
    15	  ConfigInEffect at or before that record (by its own seq); before any, the scenario's
    16	  initial configuration (passed with --initial).
    17	- A Committed record by member M at seq s defines a commit decision only if M has an
    18	  Elected record before s; its epoch e is that Elected's epoch and its configuration is
    19	  M's configuration at s. Committed records with no earlier Elected of the same member
    20	  are followers learning a commit and define nothing.
    21	- J1.1: two Elected records with the same epoch and different members. Configuration-
    22	  attributed iff their `config` fields differ.
    23	- J1.5(a): a commit decision for the entry at index i (identified by the (epoch, kind,
    24	  payload) of M's journal at i at seq s) in epoch e, and an Elected record of a member C
    25	  with epoch > e whose journal at that record has no such entry at i. Configuration-
    26	  attributed iff the commit decision's configuration differs from that Elected's config.
    27	- J1.5(b): a Truncated(member X, from_index f) where f <= X's commit index (the largest
    28	  index of X's own Committed records before it). The truncation's coordinator is the
    29	  proc of the first cause of the Truncated record; configuration-attributed iff that
    30	  coordinator's configuration at the cited record differs from the configuration of
    31	  any commit decision for an index >= f, else mechanics.
    32	usage: attribution.py <trace.jsonl> --initial m1,m2,m3,m4   prints one line per violation,
    33	then a summary line; exit 0.
    34	"""
    35	import argparse, json
    36	from collections import defaultdict
    37	
    38	
    39	def load(path):
    40	    recs = [json.loads(l) for l in open(path) if l.strip()]
    41	    byproc = defaultdict(list)
    42	    for r in recs:
    43	        if r.get('proc') != 'env':
    44	            byproc[r['proc']].append(r)
    45	    for p in byproc:
    46	        byproc[p].sort(key=lambda r: r['seq'])
    47	    return byproc
    48	
    49	
    50	def cfg(x):
    51	    return tuple(sorted(x)) if x is not None else None
    52	
    53	
    54	def config_at(recs, seq, initial):
    55	    c = initial
    56	    for r in recs:
    57	        if r['seq'] > seq:
    58	            break
    59	        if r['event'] == 'ConfigInEffect':
    60	            c = cfg(r['config'])
    61	    return c
    62	
    63	
    64	def journal_at(recs, seq):
    65	    j = {}
    66	    for r in recs:
    67	        if r['seq'] > seq:
    68	            break
    69	        if r['event'] == 'Appended':
    70	            j[r['index']] = (r['epoch'], r['kind'], json.dumps(r.get('payload'), sort_keys=True))
    71	        elif r['event'] == 'Truncated':
    72	            for i in [i for i in j if i >= r['from_index']]:
    73	                del j[i]
    74	    return j
    75	
    76	
    77	def analyse(byproc, initial):
    78	    out = []
    79	    elected = [(p, r) for p in byproc for r in byproc[p] if r['event'] == 'Elected']
    80	    # J1.1
    81	    byepoch = defaultdict(list)
    82	    for p, r in elected:
    83	        byepoch[r['epoch']].append((p, r))
    84	    for e, lst in byepoch.items():
    85	        for a in range(len(lst)):
    86	            for b in range(a + 1, len(lst)):
    87	                (pa, ra), (pb, rb) = lst[a], lst[b]
    88	                if pa != pb:
    89	                    lab = 'configuration' if cfg(ra['config']) != cfg(rb['config']) else 'mechanics'
    90	                    out.append(('J1.1', lab, f'epoch {e}: {pa}@{ra["seq"]} {cfg(ra["config"])} and {pb}@{rb["seq"]} {cfg(rb["config"])}'))
    91	    # commit decisions
    92	    commits = []
    93	    for p, recs in byproc.items():
    94	        for r in recs:
    95	            if r['event'] != 'Committed':
    96	                continue
    97	            prior = [x for x in recs if x['event'] == 'Elected' and x['seq'] < r['seq']]
    98	            if not prior:
    99	                continue
   100	            j = journal_at(recs, r['seq'])
   101	            if r['index'] not in j:
   102	                continue
   103	            commits.append({'proc': p, 'seq': r['seq'], 'index': r['index'], 'entry': j[r['index']],
   104	                            'epoch': prior[-1]['epoch'], 'config': config_at(recs, r['seq'], initial)})
   105	    # J1.5(a)
   106	    for c in commits:
   107	        for p, r in elected:
   108	            if r['epoch'] > c['epoch']:
   109	                jj = journal_at(byproc[p], r['seq'])
   110	                if jj.get(c['index']) != c['entry']:
   111	                    lab = 'configuration' if c['config'] != cfg(r['config']) else 'mechanics'
   112	                    out.append(('J1.5(a)', lab, f'index {c["index"]} committed by {c["proc"]}@{c["seq"]} in epoch {c["epoch"]} under {c["config"]}; {p}@{r["seq"]} elected in epoch {r["epoch"]} under {cfg(r["config"])} without it'))
   113	    # J1.5(b)
   114	    for p, recs in byproc.items():
   115	        for r in recs:
   116	            if r['event'] != 'Truncated':
   117	                continue
   118	            ci = max([x['index'] for x in recs if x['event'] == 'Committed' and x['seq'] < r['seq']], default=0)
   119	            if r['from_index'] > ci:
   120	                continue
   121	            causes = r.get('causes') or []
   122	            ccfg = None
   123	            if causes:
   124	                cp, cs = causes[0]['proc'], causes[0]['seq']
   125	                ccfg = config_at(byproc.get(cp, []), cs, initial)
   126	            rel = [c['config'] for c in commits if c['index'] >= r['from_index']]
   127	            lab = 'configuration' if ccfg is not None and any(x != ccfg for x in rel) else 'mechanics'
   128	            out.append(('J1.5(b)', lab, f'{p}@{r["seq"]} truncated from {r["from_index"]} at commit index {ci}; truncating coordinator config {ccfg}; commit configs {sorted(set(rel))}'))
   129	    return out
   130	
   131	
   132	def main():
   133	    ap = argparse.ArgumentParser()
   134	    ap.add_argument('trace')
   135	    ap.add_argument('--initial', required=True, help='comma-separated initial configuration')
   136	    a = ap.parse_args()
   137	    v = analyse(load(a.trace), cfg(a.initial.split(',')))
   138	    for clause, lab, detail in v:
   139	        print(f'{clause} {lab}: {detail}')
   140	    n = sum(1 for x in v if x[1] == 'configuration')
   141	    print(f'SUMMARY {a.trace}: {len(v)} violations, {n} configuration-attributed, {len(v) - n} mechanics-attributed')
   142	
   143	
   144	if __name__ == '__main__':
   145	    main()
