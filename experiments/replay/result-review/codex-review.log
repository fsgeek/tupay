     1	#!/bin/bash
     2	# Steward runs of a replay model at first-version: shared scenarios once, mutations once, and --explore with the
     3	# author's bounds, from a scratch clone, under the memory cap; --explore limited to 4 h wall-clock (log 2026-10-22).
     4	# usage: replay-model-runs.sh <author-checkout> <scratch-dir> <out-dir> <scenarios|explore>
     5	# derives: experiments/replay-prereg.md "Runs" (models once; --explore at first-version with stated bounds)
     6	set -uo pipefail
     7	A=$1; S=$2; O=$(realpath -m "$3"); WHAT=$4
     8	mkdir -p "$O"
     9	[ -e "$S" ] || { git clone -q "$A" "$S" && git -C "$S" checkout -q first-version; }
    10	git -C "$S" rev-parse HEAD > "$O/commit.txt"; cd "$S"
    11	cap() { systemd-run --user --scope -q -p MemoryMax=24G -p MemorySwapMax=0 "$@"; }
    12	date -u +%FT%TZ > "$O/$WHAT.start"
    13	if [ "$WHAT" = scenarios ]; then
    14	  for f in replay/scenarios/S*.yaml; do echo "$(basename $f .yaml) $(cap model/run.sh "$f" 2>"$O/$(basename $f .yaml).err" | tail -1)" >> "$O/shared.txt"; done
    15	  cap model/run.sh --mutations > "$O/mutations.txt" 2> "$O/mutations.err"; echo "exit $?" >> "$O/mutations.txt"
    16	else
    17	  timeout --signal=TERM --kill-after=60 4h systemd-run --user --scope -q -p MemoryMax=24G -p MemorySwapMax=0 model/run.sh --explore > "$O/explore.txt" 2> "$O/explore.err"; echo "exit $?" >> "$O/explore.txt"
    18	fi
    19	date -u +%FT%TZ > "$O/$WHAT.end"
     1	#!/bin/bash
     2	# Steward runs of a replay implementation at first-version (registration "Runs"): shared scenarios and mutations,
     3	# seeds 1-3, ten repetitions, from a scratch clone, under the memory cap.
     4	# usage: replay-impl-runs.sh <author-checkout> <scratch-dir> <out-dir>
     5	# derives: experiments/replay-prereg.md "Runs", "Labels"; docs/steward-practice.md (ten repetitions; memory cap)
     6	set -euo pipefail
     7	A=$1; S=$2; O=$(realpath -m "$3")
     8	[ -e "$S" ] && { echo "exists: $S"; exit 1; }
     9	git clone -q "$A" "$S"; git -C "$S" checkout -q first-version; mkdir -p "$O"
    10	git -C "$S" rev-parse HEAD > "$O/commit.txt"
    11	cap() { systemd-run --user --scope -q -p MemoryMax=24G -p MemorySwapMax=0 "$@"; }
    12	cd "$S"
    13	for r in $(seq 1 10); do
    14	  for f in replay/scenarios/S*.yaml; do
    15	    n=$(basename "$f" .yaml); rc=0; cap impl/run.sh "$f" --seeds 3 > "$O/.one" 2>&1 || rc=$?
    16	    sed "s|^|rep=$r scenario=$n |" "$O/.one" >> "$O/shared.txt"; echo "rep=$r scenario=$n RUNNER-EXIT $rc" >> "$O/shared.txt"
    17	  done
    18	  rc=0; cap impl/run.sh --mutations --seeds 3 > "$O/.one" 2>&1 || rc=$?
    19	  sed "s|^|rep=$r |" "$O/.one" >> "$O/mutations.txt"; echo "rep=$r RUNNER-EXIT $rc" >> "$O/mutations.txt"
    20	done
    21	rm -f "$O/.one"; date -u +%FT%TZ > "$O/end.txt"

