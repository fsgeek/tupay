   if p.name in ('shared.txt','mutations.txt','K1.txt','H1.txt','H2.txt','H3.txt','H4.txt'):
    lines=p.read_text().splitlines()
    counts=Counter()
    for l in lines:
     if any(x in l for x in (' PASS',' FAIL',' UNEXPLAINED')):
      import re
      m=re.search(r'(S[1-8]|H[1-4]|K1)(?:--mut)?(?: seed=(\\d+))?.*?(PASS|FAIL|UNEXPLAINED)(.*)',l)
      if m: counts[(m[1],m[2],m[3],m[4])]+=1
      else: counts[l]+=1
    print(p.name,len(lines),counts)
   elif p.name=='results.txt': print(p.name,p.read_text())
