// Host thread count and renamed schedule labels cannot affect seeded semantics.
// derives: C1.1, C1.4, C2.2, F1.3, F2.1, F2.2, T2, T3
func TestTimingCanonicalReplay(t *testing.T) {
 old:=runtime.GOMAXPROCS(1);defer runtime.GOMAXPROCS(old)
 for _,name:=range []string{"P18","P29","P30"} {
  for seed:=int64(1);seed<=3;seed++ {for _,mutation:=range []string{"",name} {
   t.Run(fmt.Sprintf("%s/%d/%s",name,seed,mutation),func(t *testing.T){
    s,err:=loadSchedule(name);if err!=nil{t.Fatal(err)}
    runtime.GOMAXPROCS(1);first:=canonicalTimingRun(t,s,seed,mutation)
    runtime.GOMAXPROCS(2);time.Sleep(time.Millisecond);s.Name="renamed-"+s.Name
    second:=canonicalTimingRun(t,s,seed,mutation)
    if !bytes.Equal(first,second){t.Fatal("same seed changed canonical execution after host/name perturbation")}
   })
  }}
 }
}

// Host elapsed time cannot consume a grant lifetime or progress horizon.
