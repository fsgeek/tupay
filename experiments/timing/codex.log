func TestTimingClockIsSchedulerOwned(t *testing.T) {
 e:=&Engine{};before:=e.now();time.Sleep(5*time.Millisecond)
 if e.now()!=before{t.Fatal("host elapsed time advanced scheduler")}
 e.logicalNow=e.now().Add(41*time.Millisecond)
 if e.now().Sub(before)!=41*time.Millisecond{t.Fatal("logical advancement lost precision")}
}
